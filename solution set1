# Problem 2: Swap values of two variables using traditional method and Python's tuple unpacking.
a = 10
b = 20

# Traditional method
temp = a
a = b
b = temp
print("After traditional swap:", a, b)   # 20 10

# Reset
a = 10
b = 20
# Tuple unpacking
a, b = b, a
print("After tuple unpacking swap:", a, b)   # 20 10

