# Problem 6: Demonstrate automatic type promotion using int, float, and complex.
print("int + float ->", type(5 + 2.5))          # float
print("int + complex ->", type(5 + (2 + 3j)))   # complex
print("float + complex ->", type(2.5 + (2 + 3j)))  # complex
print("int + float + complex ->", type(5 + 2.5 + (2 + 3j)))  # complex

