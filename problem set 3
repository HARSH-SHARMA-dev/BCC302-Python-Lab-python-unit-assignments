# Problem 8: Salary calculation program.
# Basic Salary = 58,750, HRA = 22% of Basic, DA = 15% of Basic, Professional Tax = ₹500.
# Calculate Gross Salary, Net Salary after deducting Professional Tax.
# Print all values using formatted print statements.
# Print the data type of Net Salary. Round Net Salary to two decimal places.
basic = 58750
hra = 0.22 * basic
da = 0.15 * basic
professional_tax = 500
gross_salary = basic + hra + da
net_salary = gross_salary - professional_tax
net_salary_rounded = round(net_salary, 2)

print("Basic Salary:", basic)
print("HRA (22%):", hra)
print("DA (15%):", da)
print("Professional Tax:", professional_tax)
print("Gross Salary:", gross_salary)
print("Net Salary (rounded to 2 decimals):", net_salary_rounded)
print("Data type of Net Salary:", type(net_salary))

# Problem 9: Create variables A = 245, B = 37, C = -128.75.
# Calculate A^2 using pow(), find absolute value of C.
# Print max and min among A, B, and abs(C).
# Calculate the average of all three numbers (A, B, C).
# Display every result with appropriate labels.
A = 245
B = 37
C = -128.75

a_squared = pow(A, 2)
abs_c = abs(C)
max_val = max(A, B, abs_c)
min_val = min(A, B, abs_c)
avg_abc = (A + B + C) / 3   # average of the original three numbers

print("A^2 (using pow):", a_squared)
print("Absolute value of C:", abs_c)
print("Maximum among A, B, abs(C):", max_val)
print("Minimum among A, B, abs(C):", min_val)
print("Average of A, B, C:", avg_abc)

# Problem 10: Create two complex variables: c1 = 6+9j, c2 = 4-7j.
# Add them, multiply them, find magnitude (abs) of each.
# Print data type of each result. Print memory address of both variables.
c1 = 6 + 9j
c2 = 4 - 7j

add_result = c1 + c2
mul_result = c1 * c2
mag_c1 = abs(c1)
mag_c2 = abs(c2)

print("c1 + c2 =", add_result, "type:", type(add_result))
print("c1 * c2 =", mul_result, "type:", type(mul_result))
print("Magnitude of c1:", mag_c1)
print("Magnitude of c2:", mag_c2)
print("Memory address of c1:", id(c1))
print("Memory address of c2:", id(c2))

