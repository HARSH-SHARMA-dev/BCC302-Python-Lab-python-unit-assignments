# Problem 3: Convert an integer into a float and a complex number.
num = 25
print("Original integer:", num, type(num))
float_num = float(num)
complex_num = complex(num)
print("Converted to float:", float_num, type(float_num))
print("Converted to complex:", complex_num, type(complex_num))

# Problem 4: Create a complex number using both 'a+bj' notation and the complex() function.
#            Also print the real and imaginary parts of a complex number.
c1 = 4 + 5j
c2 = complex(6, -3)
print("Using a+bj notation:", c1)
print("Using complex() function:", c2)
print("Real part of c1:", c1.real)
print("Imaginary part of c1:", c1.imag)
print("Real part of c2:", c2.real)
print("Imaginary part of c2:", c2.imag)

