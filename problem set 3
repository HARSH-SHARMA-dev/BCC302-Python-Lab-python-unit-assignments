# Problem 1: Declare one variable of each numerical data type and print their values and data types.
int_var = 42
float_var = 3.14159
complex_var = 2 + 3j
print("int:", int_var, type(int_var))
print("float:", float_var, type(float_var))
print("complex:", complex_var, type(complex_var))

# Problem 2: Input two integers and perform all arithmetic operations.
num1 = int(input("Enter first integer: "))
